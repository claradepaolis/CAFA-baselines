/*
 * Configuration for BLAST Baseline Nextflow Workflow
 */

manifest {
    name            = 'BLAST-Baseline-CAFA'
    description     = 'BLAST-based GO function prediction pipeline for CAFA'
    homePage        = 'https://github.com/claradepaolis/CAFA-baselines'
    author          = 'Parnal Joshi'
    version         = '1.0.0'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
}

// Default parameters
params {
    output_dir      = "results"
    max_cpus        = 36
    max_memory      = '128.GB'
}

// Local execution profile
process {
    executor = 'local'
    cpus = 4
    memory = '8.GB'
    
    withLabel: 'low_memory' {
        cpus = 1
        memory = '2.GB'
    }
    withLabel: 'high_cpu' {
        cpus = 8
        memory = '8.GB'
    }
    withLabel: 'high_memory' {
        cpus = 4
        memory = '32.GB'
    }
}

// Trace and reporting
trace {
    enabled = true
    file = "${params.output_dir}/execution_trace.txt"
    fields = 'task_id,hash,native_id,process,tag,status,exit,module,container,cpus,memory,attempt,duration,realtime,queue'
}

report {
    enabled = true
    file = "${params.output_dir}/execution_report.html"
}

timeline {
    enabled = true
    file = "${params.output_dir}/execution_timeline.html"
}

dag {
    enabled = true
    file = "${params.output_dir}/pipeline_dag.html"
}
